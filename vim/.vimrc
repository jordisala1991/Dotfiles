set nocompatible
filetype plugin indent on
syntax enable

set background=dark
set updatetime=250
set backspace=indent,eol,start
set signcolumn=yes
set nobackup
set nowritebackup
set noswapfile
set ruler
set cmdheight=2
set hidden
set whichwrap+=<,>,h,l
set ignorecase
set smartcase
set hlsearch
set incsearch
set lazyredraw
set magic
set showmatch
set matchtime=2
